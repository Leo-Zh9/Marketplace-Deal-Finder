{
  "name": "marketplace-deal-finder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --config wrangler.local.jsonc",
    "dev:full": "concurrently --kill-others-on-fail --names frontend,worker \"npm run dev\" \"npm run dev:worker\"",
    "build": "tsc -b && vite build",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "typecheck:collector": "tsc -p tsconfig.collector.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:local": "./scripts/e2e-local.sh --serve",
    "collect": "node collector/main.ts",
    "preview": "vite preview",
    "db:migrate:local": "wrangler d1 migrations apply marketplace-deal-finder-db --local",
    "db:migrate": "wrangler d1 migrations apply marketplace-deal-finder-db --remote",
    "check": "npm run lint && npm run test && npm run build && npm run typecheck:worker && npm run typecheck:collector"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "jose": "^6.2.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "miniflare": "5.20260910.0-alpha",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.0"
  }
}
