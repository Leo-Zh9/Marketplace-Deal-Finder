{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "marketplace-deal-finder-api-local",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  // Same database_id as wrangler.jsonc: only one D1 database exists. `wrangler dev` and
  // `npm run db:migrate:local` are local-only and ignore it, but anything carrying --remote
  // with this config WILL reach the production database. The file name does not protect you.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "marketplace-deal-finder-db",
      "database_id": "ac9a3013-7229-41e7-ae51-db1974193f88"
    }
  ],
  // Cloudflare Cron scheduling is UTC: there is no timezone field and no DST. The spec asks
  // for local noon, which no fixed expression satisfies year-round. 17:00 UTC is pinned to
  // EST (UTC-5), so it fires at 12:00 local in winter and 13:00 local in summer.
  // THE OPERATOR'S TIMEZONE IS AN INFERENCE, NOT A FACT -- America/Toronto, inferred from
  // the product's example search location. See docs/phase-3e-scheduling.md.
  "triggers": { "crons": ["0 17 * * *"] },
  "workflows": [
    {
      "binding": "CLEANUP_WORKFLOW",
      "name": "marketplace-deal-finder-cleanup",
      "class_name": "CleanupWorkflow"
    }
  ],
  "vars": {
    "APP_ENV": "local",
    "ALLOWED_ORIGINS": "[\"http://localhost:5173\",\"http://127.0.0.1:5173\"]"
  },
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787,
    "local_protocol": "http"
  }
}
