# Public application configuration for the browser bundle. Every VITE_* value is
# compiled into the published JavaScript and is readable by anyone.
#
# Never put a secret or an allowlist in a VITE_* value: APPROVED_EMAILS is a
# Worker secret (`wrangler secret put APPROVED_EMAILS`) and nothing else.
#
# Local development needs none of these. `npm run dev:full` uses the Worker's
# credential-free local-development identity, so no Firebase project is required.
#
# In production these are exported into the environment before `npm run build`; this
# project deploys by direct upload, so Cloudflare runs no build and dashboard build
# variables are never read. See docs/phase-2-deployment-setup.md.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_API_BASE_URL=
